# Copy to .env and fill in. NEVER commit the real .env.
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
POOL_ADDRESS=0x684C429c009088b2Ed69410d8e974aec5b4fa7Af
ORACLE_PRIVATE_KEY=0x...            # oracle account only, never the token admin
# only needed with SOURCE=apisports
APISPORTS_KEY=...                   # free key from dashboard.api-football.com
LEAGUE_ID=10                        # Czech Extraliga on API-Sports
SEASON=2026                         # API-Sports uses the start year: 2026 = 2026/27
MAX_FEE_GWEI=50
MAX_TX_PER_RUN=25
# SOURCE=file:tests/fixtures/sample_games.json   # offline demo without API quota

# Data source: thesportsdb (free, default) | apisports (paid for current season) | file:x.json
SOURCE=thesportsdb
THESPORTSDB_KEY=123                 # public free key; premium key unlocks full daily schedule
THESPORTSDB_LEAGUE=4923             # Czech Extraliga on TheSportsDB
